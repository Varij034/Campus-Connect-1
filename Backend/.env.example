# ============================================================
# Campus Connect Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# The .env file is automatically loaded by docker-compose and python-dotenv.

# ========================
# API Configuration
# ========================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO

# ========================
# Database — PostgreSQL
# ========================
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/campus_connect

# ========================
# Database — MongoDB
# ========================
MONGODB_URL=mongodb://localhost:27017/
MONGODB_DB_NAME=campus_connect

# ========================
# Database — Qdrant (Vector)
# ========================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ========================
# Authentication (JWT)
# ========================
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ========================
# LLM — Groq API
# ========================
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ========================
# Cloud Storage — Cloudinary
# ========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ========================
# File Uploads
# ========================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# ========================
# ATS Configuration
# ========================
DEFAULT_MINIMUM_ATS_SCORE=50.0
SKILL_SIMILARITY_THRESHOLD=0.7

# ========================
# Feature Flags
# ========================
# Set to "true" to enable LLM-powered features (requires GROQ_API_KEY)
USE_LLM_CHAT=false
USE_LLM_FEEDBACK=false
USE_LLM_RESUME_ENRICH=false
USE_LLM_RESUME_ENRICH_UPDATE_CANDIDATE=false

# Set to "true" to enable vector-based semantic matching (requires Qdrant)
USE_QDRANT_MATCHING=false
